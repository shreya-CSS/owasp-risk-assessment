# Copy to .env and adjust. .env is git-ignored — never commit real keys.

# --- Storage -------------------------------------------------------------------
IVA_DB_PATH=data/iva.db
IVA_REPORTS_DIR=reports

# --- Target authorization policy (restrictive defaults) -------------------------
# Loopback (localhost/127.0.0.1) is always allowed. Add other hosts/IPs/CIDRs you have
# WRITTEN permission to test, comma-separated, e.g.  IVA_ALLOWED_TARGETS=testlab.local,192.168.56.0/24
IVA_ALLOWED_TARGETS=
# Allow RFC1918 private ranges (10/8, 172.16/12, 192.168/16), e.g. a lab VM network.
IVA_ALLOW_PRIVATE_NETWORKS=false
# ZAP active scanning sends attack payloads. Enable only for a lab you control.
IVA_ALLOW_ACTIVE_SCAN=false
# Set false only for a local lab with a self-signed certificate.
IVA_VERIFY_TLS=true

# --- Limits ----------------------------------------------------------------------
IVA_TOOL_TIMEOUT=300
IVA_MAX_TOOL_TIMEOUT=1800
IVA_MAX_CONCURRENT_SCANS=1

# --- OWASP ZAP (API of a running ZAP; start it with scripts/start_zap.ps1) --------
ZAP_HOME=C:\path\to\ZAP_2.17.0
ZAP_API_URL=http://127.0.0.1:8090
ZAP_API_KEY=change-me-to-a-long-random-value

# --- Nmap ------------------------------------------------------------------------
# Leave empty to use PATH or C:\Program Files (x86)\Nmap\nmap.exe
NMAP_PATH=

# --- Nikto (Perl) -----------------------------------------------------------------
NIKTO_PATH=C:\path\to\nikto\program\nikto.pl
# Perl interpreter (Git for Windows ships one) — needed when NIKTO_PATH is nikto.pl
PERL_PATH=C:\Program Files\Git\usr\bin\perl.exe
# Extra Perl modules (e.g. XML::Writer). Auto-detected if a 'perl-lib' folder sits next to 'program'.
NIKTO_PERL_LIB=

OWASP_EDITION=2021
